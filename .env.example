# Credit Card Fraud Detection - Environment Configuration Template
# Copy this file to .env and configure your local settings if using MySQL.

# Database URL:
# For SQLite (default, zero configuration required):
DATABASE_URL=sqlite:///database/credit_card_fraud.db

# For MySQL:
# DATABASE_URL=mysql+pymysql://<user>:<password>@localhost:3306/credit_card_fraud_db

# Server Configurations
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
